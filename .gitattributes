# Slurm submission scripts and shell helpers run on Linux. core.autocrlf is
# true on the Windows working copy, so without this a fresh checkout hands
# back CRLF and the cluster fails them with $'\r': command not found.
*.sbatch text eol=lf
*.sh     text eol=lf
runtime/bouchet_all_12_package_manifest.txt text eol=lf
runtime/bouchet_moisture_sweep_package_manifest.txt text eol=lf
